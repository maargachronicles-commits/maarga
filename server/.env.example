# ---- Everything below is OPTIONAL. With no .env at all the API starts with a
# ---- local JSON store (server/data/homepage-cms.json) and local uploads
# ---- (server/uploads), pre-filled with the Figma placeholder content.

# PostgreSQL connection string used by Prisma. When set (and reachable) the API
# uses Postgres; run `npm run generate && npm run migrate` once first.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/maarga?schema=public"

# STORAGE=auto (default) | file | postgres
# STORAGE=auto

# Cloudinary (image/video uploads). Leave empty to store uploads on disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=5000
# Public origin of this API (used to build URLs for local uploads)
# PUBLIC_URL=http://localhost:5000
# Where the client (Next.js) runs — placeholder image URLs point here
# CLIENT_PUBLIC_URL=http://localhost:3000
