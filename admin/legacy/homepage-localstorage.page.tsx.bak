"use client";

import Link from "next/link";
import {
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  getEvents,
  getDestinations,
  getJourneys,
  getScholars,
  getTestimonials,
  getHomepageCuration,
  saveHomepageCuration,
  publishHomepageCuration,
  EventRecord,
  Destination,
  Journey,
  Scholar,
  Testimonial,
  HomepageCuration,
} from "@/lib/cmsStore";

const MAX_FEATURED = 3;

type SectionType =
  | "event"
  | "destination"
  | "journey"
  | "scholar"
  | "testimonial";

type DragItem = {
  type: SectionType;
  id: string;
} | null;

const emptyCuration: HomepageCuration = {
  featuredEventIds: [],
  featuredDestinationIds: [],
  featuredJourneyIds: [],
  featuredScholarIds: [],
  featuredTestimonialIds: [],

  publishedFeaturedEventIds: [],
  publishedFeaturedDestinationIds: [],
  publishedFeaturedJourneyIds: [],
  publishedFeaturedScholarIds: [],
  publishedFeaturedTestimonialIds: [],

  updatedAt: "",
  publishedAt: "",
};

export default function HomepagePage() {
  const [mounted, setMounted] =
    useState(false);

  const [events, setEvents] =
    useState<EventRecord[]>([]);

  const [destinations, setDestinations] =
    useState<Destination[]>([]);

  const [journeys, setJourneys] =
    useState<Journey[]>([]);

  const [scholars, setScholars] =
    useState<Scholar[]>([]);

  const [testimonials, setTestimonials] =
    useState<Testimonial[]>([]);

  const [curation, setCuration] =
    useState<HomepageCuration>(
      emptyCuration
    );

  const [dragging, setDragging] =
    useState<DragItem>(null);

  const [saving, setSaving] =
    useState(false);

  const [publishing, setPublishing] =
    useState(false);


  /* ============================================================
     LOAD
     ============================================================ */

  useEffect(() => {
    const loadedEvents =
      getEvents();

    const loadedDestinations =
      getDestinations();

    const loadedJourneys =
      getJourneys();

    const loadedScholars =
      getScholars();

    const loadedTestimonials =
      getTestimonials();

    const saved =
      getHomepageCuration();

    const nextCuration: HomepageCuration = {
      ...saved,

      featuredEventIds:
        saved.featuredEventIds,

      featuredDestinationIds:
        saved.featuredDestinationIds,

      featuredJourneyIds:
        saved.featuredJourneyIds,

      featuredScholarIds:
        saved.featuredScholarIds,

      featuredTestimonialIds:
        saved.featuredTestimonialIds,
    };

    /*
     * First-time setup:
     * automatically select the first 3
     * eligible records in each section.
     */
    if (
      nextCuration.featuredEventIds
        .length === 0
    ) {
      nextCuration.featuredEventIds =
        loadedEvents
          .filter(
            (event) =>
              event.status ===
                "PUBLISHED" &&
              event.showOnWebsite
          )
          .slice(0, MAX_FEATURED)
          .map(
            (event) =>
              event.id
          );
    }

    if (
      nextCuration.featuredDestinationIds
        .length === 0
    ) {
      nextCuration.featuredDestinationIds =
        loadedDestinations
          .filter(
            (destination) =>
              destination.showOnWebsite
          )
          .slice(0, MAX_FEATURED)
          .map(
            (destination) =>
              destination.id
          );
    }

    if (
      nextCuration.featuredJourneyIds
        .length === 0
    ) {
      nextCuration.featuredJourneyIds =
        loadedJourneys
          .filter(
            (journey) =>
              journey.status ===
                "PUBLISHED" &&
              journey.showOnWebsite
          )
          .slice(0, MAX_FEATURED)
          .map(
            (journey) =>
              journey.id
          );
    }

    if (
      nextCuration.featuredScholarIds
        .length === 0
    ) {
      nextCuration.featuredScholarIds =
        loadedScholars
          .filter(
            (scholar) =>
              scholar.status ===
                "Published" &&
              scholar.showOnWebsite
          )
          .slice(0, MAX_FEATURED)
          .map(
            (scholar) =>
              scholar.id
          );
    }

    if (
      nextCuration.featuredTestimonialIds
        .length === 0
    ) {
      nextCuration.featuredTestimonialIds =
        loadedTestimonials
          .filter(
            (testimonial) =>
              testimonial.status ===
                "APPROVED" &&
              testimonial.showOnWebsite
          )
          .slice(0, MAX_FEATURED)
          .map(
            (testimonial) =>
              testimonial.id
          );
    }

    setEvents(loadedEvents);
    setDestinations(
      loadedDestinations
    );
    setJourneys(
      loadedJourneys
    );
    setScholars(
      loadedScholars
    );
    setTestimonials(
      loadedTestimonials
    );
    setCuration(
      nextCuration
    );
    setMounted(true);
  }, []);


  /* ============================================================
     ELIGIBLE ITEMS
     ============================================================ */

  const availableEvents =
    useMemo(
      () =>
        events.filter(
          (event) =>
            event.status ===
              "PUBLISHED" &&
            event.showOnWebsite
        ),
      [events]
    );

  const availableDestinations =
    useMemo(
      () =>
        destinations.filter(
          (destination) =>
            destination.showOnWebsite
        ),
      [destinations]
    );

  const availableJourneys =
    useMemo(
      () =>
        journeys.filter(
          (journey) =>
            journey.status ===
              "PUBLISHED" &&
            journey.showOnWebsite
        ),
      [journeys]
    );

  const availableScholars =
    useMemo(
      () =>
        scholars.filter(
          (scholar) =>
            scholar.status ===
              "Published" &&
            scholar.showOnWebsite
        ),
      [scholars]
    );

  const availableTestimonials =
    useMemo(
      () =>
        testimonials.filter(
          (testimonial) =>
            testimonial.status ===
              "APPROVED" &&
            testimonial.showOnWebsite
        ),
      [testimonials]
    );


  /* ============================================================
     ORDERED LIST
     ============================================================ */

  const orderItems = <
    T extends { id: string }
  >(
    items: T[],
    selectedIds: string[]
  ) => {
    const selected =
      selectedIds
        .map(
          (id) =>
            items.find(
              (item) =>
                item.id === id
            )
        )
        .filter(
          (
            item
          ): item is T =>
            Boolean(item)
        );

    const remaining =
      items.filter(
        (item) =>
          !selectedIds.includes(
            item.id
          )
      );

    return [
      ...selected,
      ...remaining,
    ];
  };

  const orderedEvents =
    orderItems(
      availableEvents,
      curation.featuredEventIds
    );

  const orderedDestinations =
    orderItems(
      availableDestinations,
      curation.featuredDestinationIds
    );

  const orderedJourneys =
    orderItems(
      availableJourneys,
      curation.featuredJourneyIds
    );

  const orderedScholars =
    orderItems(
      availableScholars,
      curation.featuredScholarIds
    );

  const orderedTestimonials =
    orderItems(
      availableTestimonials,
      curation.featuredTestimonialIds
    );


  /* ============================================================
     TOGGLE
     ============================================================ */

  const toggleFeatured = (
    field:
      | "featuredEventIds"
      | "featuredDestinationIds"
      | "featuredJourneyIds"
      | "featuredScholarIds"
      | "featuredTestimonialIds",
    id: string
  ) => {
    setCuration(
      (current) => {
        const ids =
          current[field];

        if (
          ids.includes(id)
        ) {
          return {
            ...current,

            [field]:
              ids.filter(
                (itemId) =>
                  itemId !== id
              ),

            updatedAt:
              new Date().toISOString(),
          };
        }

        if (
          ids.length >=
          MAX_FEATURED
        ) {
          alert(
            `Maximum ${MAX_FEATURED} items can be featured in this section.`
          );

          return current;
        }

        return {
          ...current,

          [field]: [
            ...ids,
            id,
          ],

          updatedAt:
            new Date().toISOString(),
        };
      }
    );
  };


  /* ============================================================
     DRAG
     ============================================================ */

  const startDrag = (
    type: SectionType,
    id: string
  ) => {
    setDragging({
      type,
      id,
    });
  };


  const dropOn = (
    field:
      | "featuredEventIds"
      | "featuredDestinationIds"
      | "featuredJourneyIds"
      | "featuredScholarIds"
      | "featuredTestimonialIds",
    targetId: string,
    sectionType: SectionType
  ) => {
    if (!dragging) {
      return;
    }

    if (
      dragging.type !==
      sectionType
    ) {
      setDragging(null);
      return;
    }

    if (
      dragging.id ===
      targetId
    ) {
      setDragging(null);
      return;
    }

    setCuration(
      (current) => {
        const ids = [
          ...current[field],
        ];

        const from =
          ids.indexOf(
            dragging.id
          );

        const to =
          ids.indexOf(
            targetId
          );

        if (
          from < 0 ||
          to < 0
        ) {
          return current;
        }

        const [
          moved,
        ] = ids.splice(
          from,
          1
        );

        ids.splice(
          to,
          0,
          moved
        );

        return {
          ...current,

          [field]: ids,

          updatedAt:
            new Date().toISOString(),
        };
      }
    );

    setDragging(null);
  };


  /* ============================================================
     SAVE
     ============================================================ */

  const saveDraft = () => {
    setSaving(true);

    const updated: HomepageCuration = {
      ...curation,
      updatedAt:
        new Date().toISOString(),
    };

    saveHomepageCuration(
      updated
    );

    setCuration(
      updated
    );

    setSaving(false);
  };


  /* ============================================================
     PUBLISH
     ============================================================ */

  const publish = () => {
    setPublishing(true);

    const published =
      publishHomepageCuration(
        curation
      );

    setCuration(
      published
    );

    setPublishing(false);

    alert(
      "Homepage changes published."
    );
  };


  /* ============================================================
     PREVIEW
     ============================================================ */

  const preview = () => {
    window.open(
      "/",
      "_blank",
      "noopener,noreferrer"
    );
  };


  /* ============================================================
     LOADING
     ============================================================ */

  if (!mounted) {
    return (
      <main className="min-h-screen bg-[#FFFDFA] p-10">
        <div className="flex min-h-[400px] items-center justify-center text-[11px] text-[#888]">
          Loading homepage...
        </div>
      </main>
    );
  }


  /* ============================================================
     PAGE
     ============================================================ */

  return (
    <main className="min-h-screen bg-[#FFFDFA] p-10">

      <div className="mx-auto max-w-[1260px]">

        {/* HEADER */}

        <div className="flex items-start justify-between">

          <div>

            <p className="text-[11px] uppercase tracking-[0.18em] text-[#B43122]">
              MAARGA CMS
            </p>

            <h1 className="mt-2 font-serif text-[34px] text-[#292725]">
              Homepage Curation
            </h1>

            <p className="mt-2 text-[12px] text-[#777]">
              Control what appears on the public
              homepage. Changes require publishing.
            </p>

          </div>


          <div className="flex gap-3">

            <button
              type="button"
              onClick={preview}
              className="rounded-[6px] border border-[#555] bg-white px-5 py-3 text-[11px] text-[#292725]"
            >
              Preview Homepage
            </button>

            <button
              type="button"
              onClick={publish}
              disabled={publishing}
              className="rounded-[6px] bg-[#B43122] px-5 py-3 text-[11px] text-white disabled:opacity-50"
            >
              {publishing
                ? "Publishing..."
                : "Publish Changes"}
            </button>

          </div>

        </div>


        {/* ======================================================
            EVENTS
        ====================================================== */}

        <CurationSection
          title="Featured Events"
          availableCount={
            availableEvents.length
          }
          selectedCount={
            curation.featuredEventIds.length
          }
        >

          {orderedEvents.map(
            (event) => (
              <CurationRow
                key={event.id}
                title={event.title}
                subtitle={event.format}
                image={
                  event.photos?.[0]
                }
                selected={curation.featuredEventIds.includes(
                  event.id
                )}
                status="Published"
                onToggle={() =>
                  toggleFeatured(
                    "featuredEventIds",
                    event.id
                  )
                }
                onDragStart={() =>
                  startDrag(
                    "event",
                    event.id
                  )
                }
                onDragOver={(e) =>
                  e.preventDefault()
                }
                onDrop={() =>
                  dropOn(
                    "featuredEventIds",
                    event.id,
                    "event"
                  )
                }
              />
            )
          )}

          {orderedEvents.length ===
            0 && (
            <EmptyRow>
              No published events available.
            </EmptyRow>
          )}

        </CurationSection>


        {/* ======================================================
            DESTINATIONS
        ====================================================== */}

        <CurationSection
          title="Featured Destinations"
          availableCount={
            availableDestinations.length
          }
          selectedCount={
            curation.featuredDestinationIds.length
          }
        >

          {orderedDestinations.map(
            (destination) => (
              <CurationRow
                key={
                  destination.id
                }
                title={
                  destination.name
                }
                subtitle={
                  [
                    destination.region,
                    destination.country,
                  ]
                    .filter(
                      Boolean
                    )
                    .join(", ")
                }
                image={
                  destination.coverImage
                }
                selected={curation.featuredDestinationIds.includes(
                  destination.id
                )}
                status="Published"
                onToggle={() =>
                  toggleFeatured(
                    "featuredDestinationIds",
                    destination.id
                  )
                }
                onDragStart={() =>
                  startDrag(
                    "destination",
                    destination.id
                  )
                }
                onDragOver={(e) =>
                  e.preventDefault()
                }
                onDrop={() =>
                  dropOn(
                    "featuredDestinationIds",
                    destination.id,
                    "destination"
                  )
                }
              />
            )
          )}

          {orderedDestinations.length ===
            0 && (
            <EmptyRow>
              No visible destinations available.
            </EmptyRow>
          )}

        </CurationSection>


        {/* ======================================================
            JOURNEYS
        ====================================================== */}

        <CurationSection
          title="Featured Journeys"
          availableCount={
            availableJourneys.length
          }
          selectedCount={
            curation.featuredJourneyIds.length
          }
        >

          {orderedJourneys.map(
            (journey) => (
              <CurationRow
                key={
                  journey.id
                }
                title={
                  journey.title
                }
                subtitle={
                  journey.duration
                }
                image={
                  journey.coverImage
                }
                selected={curation.featuredJourneyIds.includes(
                  journey.id
                )}
                status="Published"
                onToggle={() =>
                  toggleFeatured(
                    "featuredJourneyIds",
                    journey.id
                  )
                }
                onDragStart={() =>
                  startDrag(
                    "journey",
                    journey.id
                  )
                }
                onDragOver={(e) =>
                  e.preventDefault()
                }
                onDrop={() =>
                  dropOn(
                    "featuredJourneyIds",
                    journey.id,
                    "journey"
                  )
                }
              />
            )
          )}

          {orderedJourneys.length ===
            0 && (
            <EmptyRow>
              No published journeys available.
            </EmptyRow>
          )}

        </CurationSection>


        {/* ======================================================
            INTELLECTS
        ====================================================== */}

        <CurationSection
          title="Featured Intellects"
          availableCount={
            availableScholars.length
          }
          selectedCount={
            curation.featuredScholarIds.length
          }
        >

          {orderedScholars.map(
            (scholar) => (
              <CurationRow
                key={
                  scholar.id
                }
                title={
                  scholar.name
                }
                subtitle={
                  scholar.credential
                }
                image={
                  scholar.portrait
                }
                selected={curation.featuredScholarIds.includes(
                  scholar.id
                )}
                status="Published"
                onToggle={() =>
                  toggleFeatured(
                    "featuredScholarIds",
                    scholar.id
                  )
                }
                onDragStart={() =>
                  startDrag(
                    "scholar",
                    scholar.id
                  )
                }
                onDragOver={(e) =>
                  e.preventDefault()
                }
                onDrop={() =>
                  dropOn(
                    "featuredScholarIds",
                    scholar.id,
                    "scholar"
                  )
                }
              />
            )
          )}

          {orderedScholars.length ===
            0 && (
            <EmptyRow>
              No published intellects available.
            </EmptyRow>
          )}

        </CurationSection>


        {/* ======================================================
            TESTIMONIALS
        ====================================================== */}

        <CurationSection
          title="Featured Testimonials"
          availableCount={
            availableTestimonials.length
          }
          selectedCount={
            curation.featuredTestimonialIds.length
          }
        >

          {orderedTestimonials.map(
            (testimonial) => (
              <TestimonialCurationRow
                key={
                  testimonial.id
                }
                testimonial={
                  testimonial
                }
                selected={curation.featuredTestimonialIds.includes(
                  testimonial.id
                )}
                onToggle={() =>
                  toggleFeatured(
                    "featuredTestimonialIds",
                    testimonial.id
                  )
                }
                onDragStart={() =>
                  startDrag(
                    "testimonial",
                    testimonial.id
                  )
                }
                onDragOver={(e) =>
                  e.preventDefault()
                }
                onDrop={() =>
                  dropOn(
                    "featuredTestimonialIds",
                    testimonial.id,
                    "testimonial"
                  )
                }
              />
            )
          )}

          {orderedTestimonials.length ===
            0 && (
            <EmptyRow>
              No approved testimonials available.
            </EmptyRow>
          )}

        </CurationSection>


        {/* SAVE */}

        <div className="mt-5 flex items-center justify-between">

          <div>

            {curation.updatedAt && (
              <p className="text-[9px] text-[#999]">
                Last changed:{" "}
                {new Date(
                  curation.updatedAt
                ).toLocaleString()}
              </p>
            )}

            {curation.publishedAt && (
              <p className="mt-1 text-[9px] text-[#999]">
                Last published:{" "}
                {new Date(
                  curation.publishedAt
                ).toLocaleString()}
              </p>
            )}

          </div>


          <button
            type="button"
            onClick={saveDraft}
            disabled={saving}
            className="rounded-[6px] border border-[#B43122] bg-white px-5 py-3 text-[11px] text-[#B43122] disabled:opacity-50"
          >
            {saving
              ? "Saving..."
              : "Save Draft Changes"}
          </button>

        </div>

      </div>

    </main>
  );
}


/* ================================================================
   SECTION
   ================================================================ */

function CurationSection({
  title,
  availableCount,
  selectedCount,
  children,
}: {
  title: string;
  availableCount: number;
  selectedCount: number;
  children: React.ReactNode;
}) {
  return (
    <section className="mt-6 overflow-hidden rounded-[10px] border border-[#DED8D1] bg-white">

      <div className="flex items-center justify-between px-6 py-5">

        <div className="flex items-center gap-3">

          <span className="text-[13px] text-[#777]">
            ⌄
          </span>

          <h2 className="text-[15px] font-semibold text-[#292725]">
            {title}
          </h2>

          <span className="text-[11px] text-[#777]">
            ({availableCount} available)
          </span>

        </div>

        <p className="text-[10px] font-medium text-[#438047]">
          {selectedCount} / {MAX_FEATURED} slots filled
        </p>

      </div>

      <div className="px-6 pb-5">
        {children}
      </div>

    </section>
  );
}


/* ================================================================
   NORMAL ROW
   ================================================================ */

function CurationRow({
  title,
  subtitle,
  image,
  selected,
  status,
  onToggle,
  onDragStart,
  onDragOver,
  onDrop,
}: {
  title: string;
  subtitle?: string;
  image?: string;
  selected: boolean;
  status: string;
  onToggle: () => void;
  onDragStart: () => void;
  onDragOver: (
    event: React.DragEvent<HTMLDivElement>
  ) => void;
  onDrop: () => void;
}) {
  return (
    <div
      draggable={selected}
      onDragStart={onDragStart}
      onDragOver={onDragOver}
      onDrop={onDrop}
      className="flex min-h-[72px] items-center border-t border-[#ECE6E0]"
    >

      <div className="mr-4 w-[15px] cursor-grab text-center text-[17px] text-[#AAA]">
        ⋮
      </div>


      <div className="h-[42px] w-[64px] shrink-0 overflow-hidden rounded-[4px] border border-[#DED8D1] bg-[#EEEAE6]">

        {image ? (
          <img
            src={image}
            alt=""
            className="h-full w-full object-cover"
          />
        ) : (
          <div className="flex h-full items-center justify-center text-[8px] text-[#AAA]">
            No image
          </div>
        )}

      </div>


      <div className="ml-5 min-w-0 flex-1">

        <p className="truncate font-serif text-[14px] text-[#292725]">
          {title}
        </p>

        {subtitle && (
          <p className="mt-1 truncate text-[9px] text-[#888]">
            {subtitle}
          </p>
        )}

      </div>


      <span className="mr-5 rounded-[5px] bg-[#E8F4E8] px-2 py-1 text-[8px] text-[#438047]">
        {status}
      </span>


      <div className="flex items-center gap-3">

        <span className="text-[10px] text-[#777]">
          Show on homepage
        </span>

        <button
          type="button"
          onClick={onToggle}
          className={`relative h-[22px] w-[40px] rounded-full transition ${
            selected
              ? "bg-[#B43122]"
              : "bg-[#DEDAD6]"
          }`}
        >

          <span
            className={`absolute top-[3px] h-[16px] w-[16px] rounded-full bg-white shadow transition ${
              selected
                ? "left-[21px]"
                : "left-[3px]"
            }`}
          />

        </button>

      </div>

    </div>
  );
}


/* ================================================================
   TESTIMONIAL ROW
   ================================================================ */

function TestimonialCurationRow({
  testimonial,
  selected,
  onToggle,
  onDragStart,
  onDragOver,
  onDrop,
}: {
  testimonial: Testimonial;
  selected: boolean;
  onToggle: () => void;
  onDragStart: () => void;
  onDragOver: (
    event: React.DragEvent<HTMLDivElement>
  ) => void;
  onDrop: () => void;
}) {
  return (
    <div
      draggable={selected}
      onDragStart={onDragStart}
      onDragOver={onDragOver}
      onDrop={onDrop}
      className="flex min-h-[95px] items-center border-t border-[#ECE6E0]"
    >

      <div className="mr-4 w-[15px] cursor-grab text-center text-[17px] text-[#AAA]">
        ⋮
      </div>


      <div className="min-w-0 flex-1 pr-6">

        <p className="line-clamp-2 font-serif text-[14px] leading-[1.45] text-[#292725]">
          &quot;{testimonial.quote}&quot;
        </p>

        <p className="mt-2 text-[10px] font-medium text-[#292725]">
          {testimonial.travellerName}
        </p>

        {testimonial.titleOrganisation && (
          <p className="mt-1 text-[9px] text-[#888]">
            {testimonial.titleOrganisation}
          </p>
        )}

      </div>


      <span className="mr-5 rounded-[5px] bg-[#E8F4E8] px-2 py-1 text-[8px] text-[#438047]">
        Approved
      </span>


      <div className="flex items-center gap-3">

        <span className="text-[10px] text-[#777]">
          Show on homepage
        </span>

        <button
          type="button"
          onClick={onToggle}
          className={`relative h-[22px] w-[40px] rounded-full ${
            selected
              ? "bg-[#B43122]"
              : "bg-[#DEDAD6]"
          }`}
        >
          <span
            className={`absolute top-[3px] h-[16px] w-[16px] rounded-full bg-white transition ${
              selected
                ? "left-[21px]"
                : "left-[3px]"
            }`}
          />
        </button>

      </div>

    </div>
  );
}


/* ================================================================
   EMPTY
   ================================================================ */

function EmptyRow({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <div className="border-t border-[#ECE6E0] py-14 text-center text-[11px] text-[#888]">
      {children}
    </div>
  );
}